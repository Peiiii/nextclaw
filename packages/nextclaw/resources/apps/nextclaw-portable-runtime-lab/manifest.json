{
  "schemaVersion": 2,
  "id": "nextclaw.portable-runtime-lab",
  "name": "日常小工具箱",
  "version": "0.6.1",
  "description": "清单、便签、专注计时和联系人整理，四个能直接使用的日常小应用。",
  "icon": "assets/icon.svg",
  "engines": {
    "nextclaw": ">=0.46.0"
  },
  "presentation": {
    "primaryPanel": "nextclaw-portable-runtime-lab-todos"
  },
  "runtime": {
    "profile": "wasi"
  },
  "distribution": {
    "mode": "universal"
  },
  "storage": {
    "scope": "global",
    "schemaVersion": 1
  },
  "permissions": {
    "storage": {
      "namespace": "portable-runtime-lab"
    },
    "allowedDomains": ["httpbin.org"],
    "documentAccess": [
      {
        "id": "documents-read",
        "mode": "read",
        "description": "读取你选择的验收目录，用于验证只读文件访问。"
      },
      {
        "id": "documents-write",
        "mode": "read-write",
        "description": "读取并修改你选择的验收目录，用于验证文件写入。"
      }
    ],
    "secrets": [
      {
        "id": "api-token",
        "title": "验证用 API Token",
        "description": "仅用于 Portable Capability Lab 的标准 WASI Secret 验证。",
        "required": false
      }
    ]
  },
  "components": [
    {
      "kind": "panel",
      "path": "panels/nextclaw-portable-runtime-lab-todos.panel"
    },
    {
      "kind": "panel",
      "path": "panels/nextclaw-portable-runtime-lab-notes.panel"
    },
    {
      "kind": "panel",
      "path": "panels/nextclaw-portable-runtime-lab-focus.panel"
    },
    {
      "kind": "panel",
      "path": "panels/nextclaw-portable-runtime-lab-contacts.panel"
    },
    {
      "kind": "panel",
      "path": "panels/nextclaw-portable-runtime-lab-panel.panel"
    },
    {
      "kind": "service",
      "path": "service-components/nextclaw-portable-runtime-lab-state"
    },
    {
      "kind": "service",
      "path": "service-components/nextclaw-portable-runtime-lab-capabilities"
    },
    {
      "kind": "service",
      "path": "service-components/nextclaw-portable-runtime-lab-sqlite"
    },
    {
      "kind": "service",
      "path": "service-components/nextclaw-portable-runtime-lab-resident"
    },
    {
      "kind": "service",
      "path": "service-components/nextclaw-portable-runtime-lab-provider"
    },
    {
      "kind": "service",
      "path": "service-components/nextclaw-portable-runtime-lab-composition"
    }
  ]
}
