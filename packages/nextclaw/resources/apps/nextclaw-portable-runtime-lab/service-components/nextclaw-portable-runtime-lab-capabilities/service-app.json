{
  "id": "nextclaw-portable-runtime-lab-capabilities",
  "title": "Portable Capability Component",
  "description": "Rust/WASM 网络、文件权限、拒绝、错误与超时演示模块。",
  "protocol": "wasi-component",
  "component": {
    "entry": "service.wasm"
  },
  "requires": {
    "modelSlots": [
      {
        "id": "summary",
        "title": "摘要模型",
        "description": "用于验证受限的 Guest 模型调用。",
        "required": false,
        "maxTokens": 256,
        "timeoutMs": 10000
      }
    ],
    "agentSlots": [
      {
        "id": "review",
        "title": "审阅 Agent",
        "description": "用于验证异步 Guest Agent 调用。",
        "required": false
      }
    ]
  },
  "actions": {
    "network_standard_http": {
      "risk": "external",
      "title": "通过标准 WASI HTTP 访问网络",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 30000 },
          "maxResponseBytes": { "type": "integer", "minimum": 1, "maximum": 65536 }
        },
        "additionalProperties": false
      }
    },
    "network_allowed": { "risk": "external", "title": "访问允许的网络（旧兼容接口）" },
    "network_denied": { "risk": "read", "title": "验证网络拒绝" },
    "network_private_denied": { "risk": "read", "title": "验证私网拒绝" },
    "network_redirect_denied": { "risk": "read", "title": "验证越权重定向拒绝" },
    "structured_failure": { "risk": "dangerous", "title": "触发结构化失败" },
    "simulate_timeout": {
      "risk": "dangerous",
      "title": "触发执行超时",
      "timeoutMs": 1200
    },
    "long_task": {
      "risk": "write",
      "title": "运行可观测长任务",
      "timeoutMs": 10000
    },
    "stream_overflow": {
      "risk": "dangerous",
      "title": "验证流背压边界",
      "timeoutMs": 10000
    },
    "memory_pressure": {
      "risk": "dangerous",
      "title": "验证内存边界",
      "timeoutMs": 10000
    },
    "runtime_info": { "risk": "read", "title": "查看共享宿主" },
    "filesystem_read": {
      "risk": "read",
      "title": "读取已授权文件"
    },
    "filesystem_write": {
      "risk": "write",
      "title": "写入已授权文件",
      "inputSchema": {
        "type": "object",
        "required": ["path", "content"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "content": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "secret_verify": {
      "risk": "read",
      "title": "验证已绑定 Secret",
      "inputSchema": {
        "type": "object",
        "required": ["slot"],
        "properties": {
          "slot": { "type": "string", "minLength": 1 },
          "expectedSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "model_complete": {
      "risk": "external",
      "title": "调用已授权模型",
      "inputSchema": {
        "type": "object",
        "required": ["slotId", "messages"],
        "properties": {
          "slotId": { "type": "string", "minLength": 1 },
          "messages": { "type": "array", "minItems": 1 },
          "maxTokens": { "type": "integer", "minimum": 1, "maximum": 4096 }
        },
        "additionalProperties": false
      }
    },
    "agent_start": {
      "risk": "external",
      "title": "启动已授权 Agent",
      "inputSchema": {
        "type": "object",
        "required": ["slotId", "input"],
        "properties": {
          "slotId": { "type": "string", "minLength": 1 },
          "input": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  }
}
