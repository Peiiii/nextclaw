{
  "name": "@nextclaw/bibo-hosted",
  "version": "0.2.1-beta.2",
  "private": true,
  "type": "module",
  "scripts": {
    "test:self-hosted": "tsx --test src/app/utils/bibo-self-hosted-auth.utils.test.ts src/app/bibo-auth.utils.test.ts",
    "logs": "tsx scripts/diagnostics/bibo-logs.controller.ts",
    "test:diagnostics": "tsx --test src/app/bibo-hosted.app.test.ts src/app/diagnostics/bibo-diagnostics.utils.test.ts src/app/bibo-run-stream.utils.test.ts",
    "tsc": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "build:ui-dependencies": "pnpm --filter @nextclaw/shared build && pnpm --filter @nextclaw/agent-chat-ui build",
    "build:client": "pnpm build:ui-dependencies && vite build",
    "build": "pnpm build:client",
    "test": "tsx --test src/app/workspace-router.test.ts src/app/bibo-auth.utils.test.ts src/app/bibo-hosted.app.test.ts src/app/bibo-run-stream.utils.test.ts src/app/services/bibo-execution.service.test.ts src/app/utils/bibo-context-files.utils.test.ts src/app/services/bibo-conversation.service.test.ts src/app/migration/bibo-edge-export.service.test.ts src/app/migration/bibo-edge-migration.service.test.ts src/app/services/model/bibo-model.service.test.ts src/app/services/bibo-edge-web.service.test.ts src/app/stores/bibo-edge-session.store.test.ts src/app/stores/cloudflare-session.store.test.ts src/app/stores/bibo-space-file.store.test.ts src/app/stores/bibo-workspace.store.test.ts src/features/search/routes/bibo-search.route.test.ts src/features/bibo-domain/services/bibo-space.service.test.ts src/features/bibo-domain/tools/bibo-space.tools.test.ts src/features/space/utils/calendar.utils.test.ts src/features/space/stores/bibo-space.store.test.ts src/features/space/managers/file-editing.manager.test.ts src/features/chat/managers/bibo-conversation.manager.test.ts",
    "smoke:client": "pnpm build:client && tsx scripts/bibo-product.smoke.ts && tsx scripts/chat/bibo-question.smoke.ts",
    "smoke:markdown": "pnpm build:client && tsx scripts/bibo-markdown.smoke.ts && tsx scripts/bibo-markdown-chat.smoke.ts",
    "smoke:editor-loading": "pnpm build:client && tsx scripts/markdown-editor/bibo-editor-loading.smoke.ts",
    "smoke:editing": "pnpm build:client && tsx scripts/markdown-editor/bibo-editing-experience.smoke.ts",
    "smoke:inbox": "pnpm build:client && tsx scripts/inbox/bibo-inbox-layout.smoke.ts",
    "smoke:composer": "pnpm build:client && tsx scripts/bibo-composer.smoke.ts",
    "smoke:live": "tsx scripts/bibo-live.smoke.ts",
    "smoke:tasks": "tsx scripts/bibo-task-latency.smoke.ts",
    "preflight:deploy": "tsx scripts/deployment/deploy-preflight.controller.ts",
    "build:deploy-dependencies": "pnpm --filter '@nextclaw/bibo-hosted^...' --if-present run build",
    "deploy": "pnpm deploy:worker",
    "deploy:worker": "pnpm preflight:deploy && pnpm build:deploy-dependencies && pnpm build:client && pnpm preflight:deploy && pnpm dlx wrangler@4.138.0 deploy --containers-rollout=none",
    "deploy:container": "pnpm preflight:deploy && pnpm build:deploy-dependencies && pnpm build && pnpm preflight:deploy && pnpm dlx wrangler@4.138.0 deploy",
    "deploy:client": "pnpm deploy:worker",
    "dev": "pnpm build:ui-dependencies && vite --mode ui --host 127.0.0.1 --port 5188 --strictPort",
    "dev:proxy": "pnpm build:ui-dependencies && vite --host 127.0.0.1 --port 5188 --strictPort",
    "dev:worker": "wrangler dev",
    "smoke:routing": "pnpm build:client && tsx scripts/bibo-routing.smoke.ts",
    "smoke:planning": "tsx scripts/workspace-planning.smoke.ts",
    "smoke:feedback": "pnpm build:client && tsx scripts/workspace-resources.smoke.ts",
    "smoke:resources": "pnpm build:client && tsx scripts/workspace-resources.smoke.ts",
    "smoke:display": "pnpm build:client && tsx scripts/workspace/bibo-display.smoke.ts",
    "smoke:recovery": "pnpm build:client && tsx scripts/chat/bibo-run-recovery.smoke.ts"
  },
  "dependencies": {
    "@cloudflare/sandbox": "0.12.10",
    "@nextclaw/core": "workspace:*",
    "@nextclaw/harness": "workspace:*",
    "@nextclaw/kernel": "workspace:*",
    "@nextclaw/ncp": "workspace:*",
    "@nextclaw/ncp-agent-runtime-next": "workspace:*",
    "@nextclaw/ncp-toolkit": "workspace:*",
    "@nextclaw/shared": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/workers-types": "^4.20260228.0",
    "@nextclaw/bibo-client": "workspace:*",
    "@nextclaw/personal-agent-ui": "workspace:*",
    "@tailwindcss/vite": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.27.3",
    "lucide-react": "^0.462.0",
    "playwright": "^1.52.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "wrangler": "^4.67.0",
    "zustand": "^5.0.2"
  }
}
