+/* The story is an itinerary, with connected stops rather than filtered sources. */
+.sources::before { content: ""; position: absolute; top: 145px; left: 25%; width: 54%; border-top: 3px dashed #a29a78; transform: rotate(2deg); }
+.source-two, .source-three { opacity: 1; }
+.source-one::after { content: "少走路"; }
+.source { background: #fffdf6; }
+.away-time { font-family: sans-serif; }
+@media (max-width: 700px) {
+  .sources::before { top: 168px; left: 16%; width: 65%; }
+  .source b { padding: 3px 0; }
+  .away p { font-size: 13px; }
+}
+.memory-compare { position: absolute; z-index: 6; left: 30%; right: 15%; bottom: 47px; color: #504065; }
+.memory-compare[hidden] { display: none; }
+.memory-compare label { display: flex; justify-content: space-between; font-size: 11px; }
+.memory-compare input { width: 100%; height: 30px; margin: 4px 0 0; accent-color: #7960c5; cursor: ew-resize; }
+.memory-compare > div { display: flex; justify-content: space-between; font-size: 10px; color: #81718f; }
+[data-frame="1"] .focus-note { display: none; }
+.source-one { translate: calc(var(--route-spread, 0) * -45px) 0; }
+.source-three { translate: calc(var(--route-spread, 0) * 40px) 0; }
+.source { transition: translate 180ms ease-out, opacity 300ms; }
+@media (max-width: 700px) {
+  .memory-compare { left: 8%; right: 8%; bottom: 48px; }
+  .memory-compare label, .memory-compare > div { font-size: 9px; }
