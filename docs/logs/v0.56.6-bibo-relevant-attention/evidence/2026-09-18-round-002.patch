+.memory-compare > div { display: flex; justify-content: space-between; font-size: 10px; color: #81718f; }
+[data-frame="1"] .focus-note { display: flex; top: 215px; }
+.memory-compare { background: #f8f5ed; border-radius: 12px; padding: 10px 15px; box-shadow: 0 2px 8px #302d3c08; }
+.memory-compare summary { font-size: 11px; cursor: pointer; text-align: center; }
+.memory-compare p { font-size: 11px; line-height: 1.8; margin: 10px 0 0; }
+.memory-compare[open] summary { margin-bottom: 12px; }
+.camera:has(.memory-compare[open]) .focus-note { visibility: hidden; }
+.source-one { translate: calc(var(--route-spread, 0) * -45px) 0; }
+.source-three { translate: calc(var(--route-spread, 0) * 40px) 0; }
+.source { transition: translate 180ms ease-out, opacity 300ms; }
