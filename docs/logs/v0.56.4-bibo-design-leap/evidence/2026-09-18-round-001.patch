+/* The camera is the whole page's stage, rather than a card below a hero. */
+body {
+  background: #f7f4e9;
+}
+header {
+  height: 80px;
+  border-bottom: 1px solid #302d3c1c;
+}
+header > button {
+  padding: 10px 17px;
+  border: 1px solid #302d3c30;
+  border-radius: 30px;
+}
+main {
+  max-width: 1080px;
+  width: calc(100% - 112px);
+}
+.intro {
+  position: relative;
+  padding: 30px 0 0;
+  align-items: center;
+}
+.intro .eyebrow {
+  font-size: 9px;
+  letter-spacing: 2.5px;
+}
+h1 {
+  font-size: clamp(48px, 6.4vw, 86px);
+  font-weight: 700;
+  line-height: 1.13;
+  letter-spacing: -5px;
+  margin-top: 16px;
+}
+h1 span {
+  display: block;
+  color: #7960c5;
+}
+.intro-note {
+  position: absolute;
+  left: 40%;
+  top: 91px;
+  max-width: 250px;
+  margin: 0 0 15px;
+  font-size: 12px;
+  line-height: 1.9;
+  padding-left: 15px;
+  border-left: 2px solid #b1a0d6;
+}
+.camera {
+  margin: 54px 0 0;
+  isolation: isolate;
+}
+.camera::before {
+  content: "";
+  position: absolute;
+  inset: 14px -12px 84px;
+  background: #dce89d;
+  border: 1px solid #302d3c22;
+  border-radius: 28px;
+  transform: rotate(-1.5deg);
+  z-index: -1;
+}
+.companion {
+  top: -154px;
+  right: 75px;
